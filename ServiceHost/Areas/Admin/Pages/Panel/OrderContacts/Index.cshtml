@page
@model ServiceHost.Areas.Admin.Pages.Panel.OrderContacts.IndexModel
@{
    ViewData["Title"] = "پیگیری‌های مشتریان";
}

<div class="pagetitle">
    <h1>لیست درخواست‌های پیگیری سفارش</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">پنل مدیریت</a></li>
            <li class="breadcrumb-item active">پیگیری سفارشات</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title text-end">پیام‌های دریافتی از مشتریان</h5>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover text-center align-middle border">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>شماره تماس مشتری</th>
                                    <th>کد پیگیری سایت</th>
                                    <th>تاریخ ثبت</th>
                                    <th>وضعیت پیگیری</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ContactList)
                                {
                                    <tr class="@(item.IsRead ? "opacity-75" : "table-warning border-warning")">
                                        <td>@item.Id</td>
                                        <td>
                                            <a href="tel:@item.PhoneNumber" class="btn btn-outline-secondary btn-sm fw-bold">
                                                <i class="bi bi-telephone-outbound me-1"></i> @item.PhoneNumber
                                            </a>
                                        </td>
                                        <td class="fw-bold text-primary">@item.TrackingCode</td>
                                        <td>@item.CreationDate</td>
                                        <td>
                                            @if (item.IsRead)
                                            {
                                                <span class="badge bg-success-light text-success border border-success">
                                                    <i class="bi bi-check-circle me-1"></i> بررسی شده
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-light text-danger border border-danger shadow-sm">
                                                    <i class="bi bi-exclamation-triangle me-1"></i> در انتظار تماس
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-info" onclick="showContactMessage('@item.Message', '@item.PhoneNumber')">
                                                <i class="bi bi-chat-left-text"></i> مشاهده پیام
                                            </button>

                                            @if (!item.IsRead)
                                            {
                                                <a asp-page-handler="MarkAsRead" asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-success"
                                                   onclick="return confirm('آیا پیگیری‌های لازم انجام شده و وضعیت به «بررسی شده» تغییر یابد؟')">
                                                    <i class="bi bi-check-lg"></i> تایید نهایی
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="contactModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info text-white border-0">
                <h5 class="modal-title">متن درخواست پیگیری</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="text-muted small mb-1">شماره مشتری:</label>
                    <h5 id="modalPhone" class="fw-bold"></h5>
                </div>
                <hr>
                <div class="bg-light p-3 rounded shadow-sm border">
                    <p id="modalMessage" class="mb-0 text-dark" style="white-space: pre-wrap; line-height: 1.8;"></p>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary w-100" data-bs-dismiss="modal">متوجه شدم</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showContactMessage(message, phone) {
            document.getElementById('modalMessage').innerText = message;
            document.getElementById('modalPhone').innerText = phone;
            new bootstrap.Modal(document.getElementById('contactModal')).show();
        }
    </script>
}