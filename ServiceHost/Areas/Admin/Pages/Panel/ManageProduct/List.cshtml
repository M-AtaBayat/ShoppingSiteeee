@page
@model ServiceHost.Areas.Admin.Pages.Panel.ManageProduct.ListModel
@{
    ViewData["Title"] = "مدیریت محصولات";
}

<div class="pagetitle">
    <h1 class="mb-3">مدیریت محصولات</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-page="/Index">صفحۀ اصلی</a></li>
            <li class="breadcrumb-item active">لیست محصولات</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">جستجوی پیشرفته</h5>
                    <form class="row g-3 align-items-center" method="get">
                        <div class="col-md-6">
                            <input type="text" class="form-control" asp-for="SearchModel.Name" placeholder="نام محصول...">
                        </div>
                        <div class="col-md-6">
                            <select class="form-select" asp-for="SearchModel.CategoryID" asp-items="Model.ProductCategories">
                                <option value="0">انتخاب دسته بندی...</option>
                            </select>
                        </div>

                        <div class="">
                            <div class="form-check form-switch" dir="rtl">
                                <input class="form-check-input" type="checkbox" asp-for="SearchModel.HasDiscount" id="discountFilter">
                                <label class="form-check-label me-3" for="discountFilter">فقط تخفیف‌دارها</label>
                            </div>
                        </div>
                        <div class="">
                            <div class="form-check form-switch" dir="rtl">
                                <input class="form-check-input" type="checkbox" asp-for="SearchModel.IsPopular" id="popularFilter">
                                <label class="form-check-label me-3" for="popularFilter">فقط محبوب‌ها</label>
                            </div>
                        </div>

                        <div class="col-md text-end">
                            <button type="submit" class="btn btn-info btn-sm">جستجو</button>
                            <a asp-page="./List" class="btn btn-success btn-sm">حذف فیلتر</a>
                            <a asp-page="./Create" class="btn btn-outline-success btn-sm">افزودن محصول جدید</a>
                        </div>
                    </form>
                </div>
            </div>


            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-end">لیست کالاها</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>عکس</th>
                                    <th style="min-width: 150px;">نام</th>
                                    <th>رنگ</th>
                                    <th>سایز</th>
                                    <th style="min-width: 150px;">قیمت (تومان)</th>
                                    <th style="min-width: 150px;">موجودی</th>
                                    <th>وضعیت</th>
                                    <th style="min-width: 300px;">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Products)
                                {
                                    <tr>
                                        <td class="number-cell">@item.Id</td>
                                        <td>
                                            <img src="~/@item.OrginalImage" style="width: 50px; height: 50px; border-radius: 8px; object-fit: cover;" />
                                        </td>
                                        <td>@item.Name</td>
                                        <td>
                                            <div style="background-color:@item.Color; width:20px; height:20px; border-radius:50%; margin:auto; border:1px solid #ddd;"></div>
                                        </td>
                                        <td>@item.Size</td>
                                        <td class="number-cell">
                                            @if (item.HasDiscount)
                                            {
                                                <del class="text-danger" style="font-size: 0.8rem;">@item.Price.ToString("N0")</del>
                                                <br />
                                                <span class="text-success fw-bold">@item.DiscountedPrice?.ToString("N0")</span>
                                            }
                                            else
                                            {
                                                <span>@item.Price.ToString("N0")</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column align-items-center">
                                                <span class="badge @(item.StockCount < 5 ? "bg-danger" : "bg-dark") mb-1">@item.StockCount</span>
                                                <button onclick="openStockModal(@item.Id, '@item.Name', @item.StockCount)" class="btn btn-sm btn-outline-secondary" style="font-size: 0.65rem;">
                                                    <i class="bi bi-plus-circle"></i> کنترل موجودی
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                             
                                            @if (item.StockCount == 0)
                                            {
                                                <span class="badge bg-warning-light text-warning">غیرفعال (اتمام موجودی)</span>
                                            }
                                            else
                                            {
                                                @if (item.IsDeleted)
                                                {
                                                    <span class="badge bg-danger-light text-danger">غیرفعال (توسط مدیر)</span>

                                                }else
                                                {
                                                    <span class="badge bg-success-light text-success">فعال</span>
                                                }
                                            }
                                            
                                        </td>

                                        <td>
                                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="ویرایش"><i class="bi bi-pencil"></i></a>

                                            <a asp-page-handler="TogglePopular" asp-route-id="@item.Id" class="btn btn-sm @(item.IsPopular ? "btn-danger" : "btn-outline-danger")" title="محبوب">
                                                <i class="bi @(item.IsPopular ? "bi-heart-fill" : "bi-heart")"></i>
                                            </a>

                                            <button onclick="openDiscountModal(@item.Id, '@item.Name', @item.HasDiscount.ToString().ToLower())"
                                                    class="btn btn-sm @(item.HasDiscount ? "btn-primary" : "btn-outline-primary")">
                                                <i class="bi bi-percent"></i> @(item.HasDiscount ? "ویرایش تخفیف" : "تخفیف")
                                            </button>

                                            @if (!item.IsDeleted)
                                            {
                                                <a asp-page-handler="Remove" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">غیرفعال</a>
                                            }
                                            else
                                            {
                                                if (item.StockCount > 0)
                                                {
                                                    <a asp-page-handler="Restore" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">فعال‌سازی</a>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-secondary opacity-50" disabled title="ابتدا موجودی را افزایش دهید">
                                                        فعال‌سازی
                                                    </button>
                                                }
                                            }

                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="discountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="ApplyDiscount">
                <div class="modal-header">
                    <h5 class="modal-title">اعمال تخفیف برای: <span id="productNameLabel" class="text-primary"></span></h5>
                    <button type="button" class="btn-close d-none" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <input type="hidden" name="id" id="productIdInput" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">درصد تخفیف را وارد کنید</label>
                        <div class="input-group">
                            <span class="input-group-text">%</span>
                            <input type="number" name="discountRate" class="form-control text-center" min="0" max="100" placeholder="مثلاً 20" required />
                        </div>
                    </div>

                    <div id="removeDiscountBox" style="display:none;" class="mt-3 border-top pt-3">
                        <p class="small text-muted">این محصول در حال حاضر تخفیف دارد.</p>
                        <a id="removeDiscountLink" href="#" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i> حذف کامل تخفیف
                        </a>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-primary">ثبت و محاسبه</button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="stockModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="IncreaseStock">
                <div class="modal-header">
                    <h5 class="modal-title">مدیریت موجودی: <span id="stockProductName" class="text-success"></span></h5>
                    <button type="button" class="btn-close d-none" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <input type="hidden" name="id" id="stockProductId" />
                    <p class="mb-3">موجودی فعلی در سیستم: <span id="currentStockCount" class="badge bg-info"></span></p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">تعداد تغییر (مثبت برای افزایش، منفی برای کاهش):</label>
                        <input type="number" name="count" class="form-control text-center"
                               placeholder="مثلاً 10 یا 10-" required />
                    </div>
                    <p class="small text-muted">مثال: برای کم کردن ۵ عدد، بنویسید: <span dir="ltr"> -5 </span></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                    <button type="submit" class="btn btn-success">ثبت تغییرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('discountFilter').addEventListener('change', function() {
            this.form.submit();
        });
        document.getElementById('popularFilter').addEventListener('change', function() {
            this.form.submit();
        });

        function openDiscountModal(id, name, hasDiscount) {
            document.getElementById('productIdInput').value = id;
            document.getElementById('productNameLabel').innerText = name;

            const removeBox = document.getElementById('removeDiscountBox');
            const removeLink = document.getElementById('removeDiscountLink');

            if (hasDiscount) {
                removeBox.style.display = 'block';
                removeLink.href = `?handler=RemoveDiscount&id=${id}`;
            } else {
                removeBox.style.display = 'none';
            }

            var myModal = new bootstrap.Modal(document.getElementById('discountModal'));
            myModal.show();
        }


        function openStockModal(id, name, currentStock) {
            document.getElementById('stockProductId').value = id;
            document.getElementById('stockProductName').innerText = name;
            document.getElementById('currentStockCount').innerText = currentStock;
            var myModal = new bootstrap.Modal(document.getElementById('stockModal'));
            myModal.show();
        }
    </script>
}
