@page
@model ServiceHost.Areas.Admin.Pages.Panel.ManageOrder.DeliveredModel
@{
    ViewData["Title"] = "سفارشات تحویل داده شده";
}

<div class="pagetitle">
    <h1>آرشیو سفارشات موفق</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">پنل مدیریت</a></li>
            <li class="breadcrumb-item active">تحویل داده شده</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">جستجو در آرشیو نهایی</h5>
                    <form class="row g-3" method="get">
                        <div class="col-md-4">
                            <input type="text" class="form-control" asp-for="SearchModel.TrackingCode" placeholder="کد پیگیری سایت...">
                        </div>
                        <div class="col-md-4">
                            <input type="text" class="form-control" asp-for="SearchModel.PostTrackingCode" placeholder="کد رهگیری پستی...">
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-dark">جستجو</button>
                            <a asp-page="./Delivered" class="btn btn-outline-secondary">لیست کامل</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title text-end">سفارشات تحویل شده</h5>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover text-center align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th style="min-width:150px;">کد پیگیری سایت</th>
                                    <th>نام مشتری</th>
                                    <th style="min-width:200px;">مبلغ نهایی (تومان)</th>
                                    <th>تاریخ تحویل</th>
                                    <th class="alamiat">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Orders)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td class="fw-bold">@item.TrackingCode</td>
                                        <td>@item.ReceiverName</td>
                                        <td class="text-success fw-bold">@item.FinalAmount.ToString("N0")</td>
                                        <td>@item.DeliveredDate?.ToString("yyyy/MM/dd")</td>
                                        <td>
                                            <button class="btn btn-sm btn-secondary" onclick='showDetails(@Html.Raw(Json.Serialize(item)))'>
                                                <i class="bi bi-file-earmark-text"></i> جزئیات فاکتور
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content order-details-modal">
            <div class="modal-header order-details-header">
                <h5 class="modal-title">
                    <i class="bi bi-receipt-cutoff"></i> جزئیات کامل سفارش
                </h5>
                @* <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button> *@
            </div>
            <div id="detailsBody" class="modal-body order-details-body"></div>
        </div>
    </div>
</div>

<style>
    .order-details-modal {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,.18);
    }

    .order-details-header {
        background: linear-gradient(135deg, #4154f1, #2e3ad1);
        border: none;
        padding: 1.1rem 1.5rem;
    }

        .order-details-header .modal-title {
            color: #fff;
            font-weight: 700;
            font-size: 1.15rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .order-details-body {
        background: #f8f9fc;
        padding: 1.5rem;
    }

    .order-info-card, .order-items-card {
        background: #fff;
        border-radius: 12px;
        padding: 1.1rem 1.3rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        margin-bottom: 1.2rem;
    }

    .order-items-card {
        margin-bottom: 0;
    }

        .order-items-card h6 {
            color: #012970;
            font-weight: 700;
            margin-bottom: 1rem;
        }

    .order-info-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 10px;
        font-size: .92rem;
        color: #344;
    }

        .order-info-row i {
            color: #4154f1;
            width: 20px;
            text-align: center;
        }

        .order-info-row b {
            color: #012970;
            margin-left: 4px;
        }

    .order-item-thumb {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #eee;
    }

    .badge-color, .badge-size {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: .78rem;
        font-weight: 600;
    }

    .badge-color {
        background: #eef2ff;
        color: #4154f1;
    }

    .badge-size {
        background: #fff4e6;
        color: #e67e22;
    }

    .order-total-bar {
        margin-top: 1.2rem;
        background: linear-gradient(135deg, #e9fbf0, #d7f7e3);
        border-radius: 12px;
        padding: .9rem 1.3rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .order-total-bar span:first-child {
            font-weight: 600;
            color: #1f9d55;
        }

        .order-total-bar span:last-child {
            color: #157a40;
            font-weight: 800;
            font-size: 1.1rem;
        }

    th {
        min-width: 100px;
    }

    .alamiat {
        min-width: 250px;
        justify-content: space-between;
    }
</style>


@section Scripts {
    <script>
        function showDetails(order) {
            const body = document.getElementById('detailsBody');

            let itemsTable = `
                <div class="mt-4">
                    <h6 class="fw-bold border-bottom pb-2">لیست محصولات تحویل شده:</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>تصویر</th>
                                    <th style="min-width:150px;">نام محصول</th>
                                    <th>تعداد</th>
                                    <th>قیمت واحد</th>
                                    <th>جمع کالا</th>
                                </tr>
                            </thead>
                            <tbody>
            `;

            if (order.items && order.items.length > 0) {
                order.items.forEach(item => {
                    let imgSrc = item.productImage;
                    itemsTable += `
                        <tr class="">
                            <td><img src="/${imgSrc}" style="width: 45px; height: 45px; object-fit: cover; border-radius: 5px;"></td>
                            <td class="text-center fw-bold text-primary">${item.productName || '---'}</td>
                            <td><span class="badge bg-dark">${item.count}</span></td>
                            <td>${item.unitPrice.toLocaleString()}</td>
                            <td class="text-success fw-bold">${item.totalItemPrice.toLocaleString()}</td>
                        </tr>
                    `;
                });
            } else {
                itemsTable += `<tr><td colspan="5" class="text-danger">اقلامی ثبت نشده است.</td></tr>`;
            }

            itemsTable += `</tbody></table></div></div>`;

            body.innerHTML = `
                <div class="p-2">
                    <div class="row mb-3">
                        <div class="col-12">
                            <p class="mb-0 text-muted">کد پیگیری سایت:</p>
                            <h5 class="fw-bold">${order.trackingCode}</h5>
                        </div>
                        <div class="col-12 text-end">
                            <p class="mb-0 text-muted">کد رهگیری پست:</p>
                            <h5 class="text-success fw-bold">${order.postTrackingCode || '---'}</h5>
                        </div>
                    </div>
                    <div class="row bg-light p-3 rounded mb-3">
                        <div class="col-md-6 border-end">
                            <h6><b>مشخصات مشتری:</b></h6>
                            <span class="mb-1">${order.receiverName}</span> - 
                            <span class="mb-1 small text-muted">${order.receiverPhoneNumber}</span>
                        </div>
                        <div class="col-md-6 ps-md-4">
                            <h6><b>آدرس تحویل:</b></h6>
                            <p class="small mb-0">${order.province}، ${order.city}، ${order.address}</p>
                        </div>
                    </div>
                    <div class="row text-center mb-3">
                        <div class="col-4 border-end">
                            <p class="small text-muted mb-0">ثبت سفارش</p>
                            <p class="fw-bold small">${order.creationDatePersian}</p>
                        </div>
                        <div class="col-4 border-end">
                            <p class="small text-muted mb-0">تاریخ ارسال</p>
                            <p class="fw-bold small">${order.sentDate ? new Date(order.sentDate).toLocaleDateString('fa-IR') : '---'}</p>
                        </div>
                        <div class="col-4">
                            <p class="small text-muted mb-0">تاریخ تحویل نهایی</p>
                            <p class="fw-bold text-success small">${order.deliveredDate ? new Date(order.deliveredDate).toLocaleDateString('fa-IR') : '---'}</p>
                        </div>
                    </div>
                    ${itemsTable}
                    <hr>
                    <div class="d-flex justify-content-between align-items-center bg-dark text-white p-3 rounded">
                        <h6 class="mb-0">جمع کل واریزی (شامل هزینه ارسال):</h6>
                        <h5 class="mb-0 fw-bold">${order.finalAmount.toLocaleString()} تومان</h5>
                    </div>
                </div>
            `;

            new bootstrap.Modal(document.getElementById('detailsModal')).show();
        }
    </script>
}