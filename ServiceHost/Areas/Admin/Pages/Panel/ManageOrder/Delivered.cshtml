@page
@model ServiceHost.Areas.Admin.Pages.Panel.ManageOrder.DeliveredModel
@{
    ViewData["Title"] = "سفارشات تحویل داده شده";
}

<div class="pagetitle">
    <h1>آرشیو سفارشات موفق</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">پنل مدیریت</a></li>
            <li class="breadcrumb-item active">تحویل داده شده</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">جستجو در آرشیو نهایی</h5>
                    <form class="row g-3" method="get">
                        <div class="col-md-4">
                            <input type="text" class="form-control" asp-for="SearchModel.TrackingCode" placeholder="کد پیگیری سایت...">
                        </div>
                        <div class="col-md-4">
                            <input type="text" class="form-control" asp-for="SearchModel.PostTrackingCode" placeholder="کد رهگیری پستی...">
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-dark">جستجو</button>
                            <a asp-page="./Delivered" class="btn btn-outline-secondary">لیست کامل</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title text-end">سفارشات تحویل شده</h5>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover text-center align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>کد پیگیری سایت</th>
                                    <th>نام مشتری</th>
                                    <th>مبلغ نهایی (تومان)</th>
                                    <th>تاریخ تحویل</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Orders)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td class="fw-bold">@item.TrackingCode</td>
                                        <td>@item.ReceiverName</td>
                                        <td class="text-success fw-bold">@item.FinalAmount.ToString("N0")</td>
                                        <td>@item.DeliveredDate?.ToString("yyyy/MM/dd")</td>
                                        <td>
                                            <button class="btn btn-sm btn-secondary" onclick='showDetails(@Html.Raw(Json.Serialize(item)))'>
                                                <i class="bi bi-file-earmark-text"></i> جزئیات فاکتور
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">خلاصه فاکتور نهایی و اقلام ارسالی</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div id="detailsBody" class="modal-body shadow-sm">
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                <button type="button" class="btn btn-primary" onclick="window.print()">
                    <i class="bi bi-printer"></i> چاپ فاکتور
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showDetails(order) {
            const body = document.getElementById('detailsBody');

            let itemsTable = `
                <div class="mt-4">
                    <h6 class="fw-bold border-bottom pb-2">لیست محصولات تحویل شده:</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>تصویر</th>
                                    <th>نام محصول</th>
                                    <th>تعداد</th>
                                    <th>قیمت واحد</th>
                                    <th>جمع کالا</th>
                                </tr>
                            </thead>
                            <tbody>
            `;

            if (order.items && order.items.length > 0) {
                order.items.forEach(item => {
                    let imgSrc = item.productImage ? '/ProductPictures/' + item.productImage : '/assets/img/default-product.png';
                    itemsTable += `
                        <tr>
                            <td><img src="${imgSrc}" style="width: 45px; height: 45px; object-fit: cover; border-radius: 5px;"></td>
                            <td class="text-start fw-bold text-primary">${item.productName || '---'}</td>
                            <td><span class="badge bg-dark">${item.count}</span></td>
                            <td>${item.unitPrice.toLocaleString()}</td>
                            <td class="text-success fw-bold">${item.totalItemPrice.toLocaleString()}</td>
                        </tr>
                    `;
                });
            } else {
                itemsTable += `<tr><td colspan="5" class="text-danger">اقلامی ثبت نشده است.</td></tr>`;
            }

            itemsTable += `</tbody></table></div></div>`;

            body.innerHTML = `
                <div class="p-2">
                    <div class="row mb-3">
                        <div class="col-6">
                            <p class="mb-0 text-muted">کد پیگیری سایت:</p>
                            <h5 class="fw-bold">${order.trackingCode}</h5>
                        </div>
                        <div class="col-6 text-end">
                            <p class="mb-0 text-muted">کد رهگیری پست:</p>
                            <h5 class="text-success fw-bold">${order.postTrackingCode || '---'}</h5>
                        </div>
                    </div>
                    <div class="row bg-light p-3 rounded mb-3">
                        <div class="col-md-6 border-end">
                            <h6><b>مشخصات مشتری:</b></h6>
                            <p class="mb-1">${order.receiverName}</p>
                            <p class="mb-1 small text-muted">${order.receiverPhoneNumber}</p>
                        </div>
                        <div class="col-md-6 ps-md-4">
                            <h6><b>آدرس تحویل:</b></h6>
                            <p class="small mb-0">${order.province}، ${order.city}، ${order.address}</p>
                        </div>
                    </div>
                    <div class="row text-center mb-3">
                        <div class="col-4 border-end">
                            <p class="small text-muted mb-0">ثبت سفارش</p>
                            <p class="fw-bold small">${order.creationDatePersian}</p>
                        </div>
                        <div class="col-4 border-end">
                            <p class="small text-muted mb-0">تاریخ ارسال</p>
                            <p class="fw-bold small">${order.sentDate ? new Date(order.sentDate).toLocaleDateString('fa-IR') : '---'}</p>
                        </div>
                        <div class="col-4">
                            <p class="small text-muted mb-0">تاریخ تحویل نهایی</p>
                            <p class="fw-bold text-success small">${order.deliveredDate ? new Date(order.deliveredDate).toLocaleDateString('fa-IR') : '---'}</p>
                        </div>
                    </div>
                    ${itemsTable}
                    <hr>
                    <div class="d-flex justify-content-between align-items-center bg-dark text-white p-3 rounded">
                        <h6 class="mb-0">جمع کل واریزی (شامل هزینه ارسال):</h6>
                        <h5 class="mb-0 fw-bold">${order.finalAmount.toLocaleString()} تومان</h5>
                    </div>
                </div>
            `;

            new bootstrap.Modal(document.getElementById('detailsModal')).show();
        }
    </script>
}