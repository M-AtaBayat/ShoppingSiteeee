@page
@model ServiceHost.Areas.Admin.Pages.Panel.ManageOrder.ProcessingModel
@{
    ViewData["Title"] = "سفارشات جاری";
}

<div class="pagetitle">
    <h1>مدیریت سفارشات جاری</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">پنل مدیریت</a></li>
            <li class="breadcrumb-item active">سفارشات در حال پردازش</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">جستجو با کد پیگیری سایت</h5>
                    <form class="row g-3" method="get">
                        <div class="col-md-6">
                            <input type="text" class="form-control" asp-for="SearchModel.TrackingCode" placeholder="کد پیگیری را وارد کنید...">
                        </div>
                        <div class="col-md-6">
                            <button type="submit" class="btn btn-primary">جستجو</button>
                            <a asp-page="./Processing" class="btn btn-secondary">نمایش همه</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title text-end">لیست سفارشات جدید</h5>
                    <div class="table-responsive">
                        <table class="table table-hover text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th style="min-width:150px;">کد پیگیری سایت</th>
                                    <th>نام گیرنده</th>
                                    <th>شماره تماس</th>
                                    <th style="min-width:180px;">مبلغ کل (تومان)</th>
                                    <th>تاریخ ثبت</th>
                                    <th class="alamiat">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Orders)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td class="fw-bold text-primary">@item.TrackingCode</td>
                                        <td>@item.ReceiverName</td>
                                        <td>@item.ReceiverPhoneNumber</td>
                                        <td class="number-cell">@item.FinalAmount.ToString("N0")</td>
                                        <td>@item.CreationDatePersian</td>
                                        <td>
                                            <button class="btn btn-sm btn-info" onclick='showDetails(@Html.Raw(Json.Serialize(item)))'>
                                                @* <i class="bi bi-eye"></i> *@
                                                جزئیات
                                            </button>
                                            
                                            <button class="btn btn-sm btn-success" onclick="openSendModal(@item.Id, '@item.TrackingCode')">
                                                @* <i class="bi bi-truck"></i> *@
                                                ارسال شد
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="sendModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Confirm">
                <div class="modal-header">
                    <h5 class="modal-title">ثبت خروج از انبار - کد پیگیری: <span id="modalTrackingCode" class="text-primary"></span></h5>
                    @* <button type="button" class="btn-close" data-bs-dismiss="modal"></button> *@
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="modalOrderId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">کد رهگیری ۲۴ رقمی پست را وارد کنید:</label>
                        <input type="text" name="postTrackingCode" class="form-control text-center" placeholder="مثلاً: 123456789012345678901234" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-success">تایید و تغییر وضعیت به ارسال شده</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content order-details-modal">
            <div class="modal-header order-details-header">
                <h5 class="modal-title">
                    <i class="bi bi-receipt-cutoff"></i> جزئیات کامل سفارش
                </h5>
                @* <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button> *@
            </div>
            <div id="detailsBody" class="modal-body order-details-body"></div>
        </div>
    </div>
</div>

<style>
    .order-details-modal {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,.18);
    }

    .order-details-header {
        background: linear-gradient(135deg, #4154f1, #2e3ad1);
        border: none;
        padding: 1.1rem 1.5rem;
    }

        .order-details-header .modal-title {
            color: #fff;
            font-weight: 700;
            font-size: 1.15rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .order-details-body {
        background: #f8f9fc;
        padding: 1.5rem;
    }

    .order-info-card, .order-items-card {
        background: #fff;
        border-radius: 12px;
        padding: 1.1rem 1.3rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        margin-bottom: 1.2rem;
    }

    .order-items-card {
        margin-bottom: 0;
    }

        .order-items-card h6 {
            color: #012970;
            font-weight: 700;
            margin-bottom: 1rem;
        }

    .order-info-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 10px;
        font-size: .92rem;
        color: #344;
    }

        .order-info-row i {
            color: #4154f1;
            width: 20px;
            text-align: center;
        }

        .order-info-row b {
            color: #012970;
            margin-left: 4px;
        }

    .order-item-thumb {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #eee;
    }

    .badge-color, .badge-size {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: .78rem;
        font-weight: 600;
    }

    .badge-color {
        background: #eef2ff;
        color: #4154f1;
    }

    .badge-size {
        background: #fff4e6;
        color: #e67e22;
    }

    .order-total-bar {
        margin-top: 1.2rem;
        background: linear-gradient(135deg, #e9fbf0, #d7f7e3);
        border-radius: 12px;
        padding: .9rem 1.3rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .order-total-bar span:first-child {
            font-weight: 600;
            color: #1f9d55;
        }

        .order-total-bar span:last-child {
            color: #157a40;
            font-weight: 800;
            font-size: 1.1rem;
        }
        th{
            min-width:100px;
        }
        .alamiat{
            min-width:250px;
            justify-content:space-between;
        }
</style>

@section Scripts {
    <script>
        function openSendModal(id, code) {
            document.getElementById('modalOrderId').value = id;
            document.getElementById('modalTrackingCode').innerText = code;
            new bootstrap.Modal(document.getElementById('sendModal')).show();
        }

                function showDetails(order) {
            const body = document.getElementById('detailsBody');

            let itemsRows = '';
            if (order.items && order.items.length > 0) {
                order.items.forEach(item => {
                    let imgSrc = item.productImage;
                    itemsRows += `
                        <tr>
                            <td><img src="/${imgSrc}" class="order-item-thumb"></td>
                            <td class="fw-bold text-primary">${item.productName || '---'}</td>
                            <td>
                                            <div style="background-color:${item.Color} ; width:20px; height:20px; border-radius:50%; margin:auto; border:1px solid #ddd;"></div>
                                        </td>
                            <td>${item.size ? `<span class="badge-size">${item.size}</span>` : '<span class="text-muted">—</span>'}</td>
                            <td><span class="badge bg-secondary">${item.count}</span></td>
                            <td>${item.unitPrice.toLocaleString()}</td>
                            <td class="text-success fw-bold">${item.totalItemPrice.toLocaleString()}</td>
                        </tr>
                    `;
                });
            } else {
                itemsRows = `<tr><td colspan="7" class="text-danger py-3">آیتمی یافت نشد یا در دیتابیس ثبت نشده است!</td></tr>`;
            }

            body.innerHTML = `
                <div class="order-info-card">
                    <div class="row g-2">
                        <div class="col-md-6 order-info-row"><i class="bi bi-hash"></i><b>کد پیگیری:</b> <span class="text-primary">${order.trackingCode}</span></div>
                        <div class="col-md-6 order-info-row"><i class="bi bi-clock-history"></i><b>زمان ثبت:</b> ${order.creationDatePersian}</div>
                        <div class="col-md-6 order-info-row"><i class="bi bi-person"></i><b>گیرنده:</b> ${order.receiverName}</div>
                        <div class="col-md-6 order-info-row"><i class="bi bi-telephone"></i><b>تماس:</b> ${order.receiverPhoneNumber}</div>
                        <div class="col-md-12 order-info-row"><i class="bi bi-geo-alt"></i><b>آدرس:</b> ${order.province}، ${order.city}، ${order.address}</div>
                        <div class="col-md-6 order-info-row"><i class="bi bi-mailbox"></i><b>کد پستی:</b> ${order.postalCode}</div>
                    </div>
                </div>

                <div class="order-items-card">
                    <h6><i class="bi bi-bag-check"></i> اقلام سفارش</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless text-center align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>تصویر</th><th>نام محصول</th><th>رنگ</th><th>سایز</th>
                                    <th>تعداد</th><th>قیمت واحد</th><th>جمع</th>
                                </tr>
                            </thead>
                            <tbody>${itemsRows}</tbody>
                        </table>
                    </div>
                </div>

                <div class="order-total-bar">
                    <span><i class="bi bi-wallet2"></i> مبلغ نهایی (با هزینه ارسال)</span>
                    <span>${order.finalAmount.toLocaleString()} تومان</span>
                </div>
            `;

            new bootstrap.Modal(document.getElementById('detailsModal')).show();
        }
    </script>
}