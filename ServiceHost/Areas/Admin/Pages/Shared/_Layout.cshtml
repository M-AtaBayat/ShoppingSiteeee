<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>Admin Management</title>
    <meta content="" name="description">
    <meta content="" name="keywords">

    <link href="~/Admin/assets/img/favicon.png" rel="icon">
    <link href="~/Admin/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <link href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

    <link href="~/Admin/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Admin/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Admin/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
    <link href="~/Admin/assets/vendor/quill/quill.snow.css" rel="stylesheet">
    <link href="~/Admin/assets/vendor/quill/quill.bubble.css" rel="stylesheet">
    <link href="~/Admin/assets/vendor/remixicon/remixicon.css" rel="stylesheet">
    <link href="~/Admin/assets/vendor/simple-datatables/style.css" rel="stylesheet">

    <link href="~/Admin/assets/css/jalalidatepicker.min.css" type="text/css" rel="stylesheet">
    <link href="~/Admin/assets/css/style.css" rel="stylesheet">
</head>

<body>

    <header id="header" class="header fixed-top d-flex align-items-center">

        <div class="d-flex align-items-center justify-content-between">
            <a asp-page="/Index" asp-area="Admin" class="logo d-flex align-items-center">
                <span class="d-none d-lg-block">پنل مدیریت </span>
            </a>
            <i class="bi bi-list toggle-sidebar-btn mt-2 ms-3"></i>
            <a asp-area="" asp-page="/Index" class="d-none d-lg-block ms-2 btn btn-outline-info text-dark">
                نمایش سایت
            </a>
        </div><nav class="header-nav me-auto">
            <ul class="d-flex align-items-center">
                <li class="nav-item dropdown pe-3">
                    <a class="nav-link nav-profile d-flex align-items-center ps-3 text-danger" asp-area="Admin" asp-page="/Index" asp-page-handler="Logout">
                        <i class="bi bi-box-arrow-right ms-2"></i>
                        <span>خروج از حساب</span>
                    </a>
                </li>
            </ul>
        </nav>
    </header>
    <aside id="sidebar" class="sidebar">

        <ul class="sidebar-nav" id="sidebar-nav">

            <li class="nav-item">
                <a class="nav-link " asp-page="/Index" asp-area="Admin">
                    <i class="bi bi-grid"></i>
                    <span>داشبورد</span>
                </a>
            </li>
            @* product category *@
            <li class="nav-item">
                <a class="nav-link collapsed" data-bs-target="#productscategory-nav" data-bs-toggle="collapse" href="#">
                    <i class="bi bi-menu-button-wide"></i><span>دسته بندی محصولات</span><i class="bi bi-chevron-down me-auto"></i>
                </a>
                <ul id="productscategory-nav" class="nav-content collapse " data-bs-parent="#sidebar-nav">
                    <li>
                        <a asp-page="/Panel/ManageProductCategory/List">
                            <i class="bi bi-circle"></i><span>نمایش همه</span>
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Panel/ManageProductCategory/Create">
                            <i class="bi bi-circle"></i><span>افزودن</span>
                        </a>
                    </li>
                </ul>
            </li>
            @* ManageProduct *@
            <li class="nav-item">
                <a class="nav-link collapsed" data-bs-target="#ManageProduct-nav" data-bs-toggle="collapse" href="#">
                    <i class="bi bi-menu-button-wide"></i><span>محصولات</span><i class="bi bi-chevron-down me-auto"></i>
                </a>
                <ul id="ManageProduct-nav" class="nav-content collapse " data-bs-parent="#sidebar-nav">
                    <li>
                        <a asp-page="/Panel/ManageProduct/List">
                            <i class="bi bi-circle"></i><span>نمایش همه</span>
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Panel/ManageProduct/Create">
                            <i class="bi bi-circle"></i><span>افزودن</span>
                        </a>
                    </li>
                </ul>
            </li>
            @* ManageOrder *@
            <li class="nav-item">
                <a class="nav-link collapsed" data-bs-target="#ManageOrder-nav" data-bs-toggle="collapse" href="#">
                    <i class="bi bi-menu-button-wide"></i><span>سفارشات</span><i class="bi bi-chevron-down me-auto"></i>
                </a>
                <ul id="ManageOrder-nav" class="nav-content collapse " data-bs-parent="#sidebar-nav">
                    <li>
                        <a asp-page="/Panel/ManageOrder/Processing">
                            <i class="bi bi-circle"></i><span>سفارشات درحال پردازش</span>
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Panel/ManageOrder/Sent">
                            <i class="bi bi-circle"></i><span>سفارشات ارسال شده</span>
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Panel/ManageOrder/Delivered">
                            <i class="bi bi-circle"></i><span>سفارشات تحویل داده شده</span>
                        </a>
                    </li>
                </ul>
            </li>
            @* Settings *@
            <li class="nav-item">
                <a class="nav-link collapsed" data-bs-target="#Settings-nav" data-bs-toggle="collapse" href="#">
                    <i class="bi bi-menu-button-wide"></i><span>تنظیمات عمومی</span><i class="bi bi-chevron-down me-auto"></i>
                </a>
                <ul id="Settings-nav" class="nav-content collapse " data-bs-parent="#sidebar-nav">
                    <li>
                        <a asp-page="/Panel/Settings/Index">
                            <i class="bi bi-circle"></i><span>هزینه ارسال</span>
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Panel/OrderContacts/Index">
                            <i class="bi bi-circle"></i><span>پیگیری مشتریان</span>
                        </a>
                    </li>
                </ul>
            </li>
        </ul>

    </aside>
    <main id="main" class="main">
        @RenderBody()
    </main>
    <footer id="footer" class="footer" dir="ltr">
        <div class="copyright">
            &copy; Copyright <strong><span></span></strong>. All Rights Reserved
        </div>
        <div class="credits">
            Designed by <a href="https://Github.com/M-AtaBayat">Mohammad Ata Bayat</a>
        </div>
    </footer>
    <script src="~/Admin/assets/vendor/apexcharts/apexcharts.min.js"></script>
    <script src="~/Admin/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Admin/assets/vendor/chart.js/chart.umd.js"></script>
    <script src="~/Admin/assets/vendor/echarts/echarts.min.js"></script>
    <script src="~/Admin/assets/vendor/quill/quill.js"></script>
    <script src="~/Admin/assets/vendor/simple-datatables/simple-datatables.js"></script>
    <script src="~/Admin/assets/vendor/tinymce/tinymce.min.js"></script>
    <script src="~/Admin/assets/vendor/php-email-form/validate.js"></script>

    <script src="~/Admin/assets/js/jalalidatepicker.min.js" type="text/javascript"></script>
    <script src="~/Admin/assets/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
