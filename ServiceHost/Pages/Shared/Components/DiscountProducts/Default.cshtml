@using _01_ShoppingSiteQuery.Contracts.Product
@model List<ProductQueryModel>

@if (Model != null && Model.Any())
{
    <section class="discount-products-section pb-0 pt-4 pr-4" id="discountProducts">
        <div class="section-header">
            <h3 class="section-title">محصولات پر تخفیف</h3>
        </div>
        <div class="products-scroll-wrapper scroll" id="discountProductsWrapper">
            <div class="products-container">
                @foreach (var item in Model)
                {
                    <div class="product-card discount">
                        <div class="product-img">
                            <img src="~/@item.Picture" alt="@item.Name" title="@item.Name">
                            <span class="discount-badge">@item.DiscountRate% تخفیف</span>
                        </div>
                        <h4 class="product-name">@item.Name</h4>
                        <div class="product-actions row justify-content-around mb-1">
                            <span class="color-box shadow-sm" style="background:@item.Color; border: 1px solid #ddd;width:15px; height:15px;"></span>
                            <span class="text-muted">@item.Size</span>
                        </div>
                        <div class="product-price">
                            <span class="old-price">@item.Price.ToString("N0") تومان</span>
                            <span class="new-price">@item.PriceWithDiscount تومان</span>
                        </div>
                        <div class="product-actions">
                            <style>
                                .product-card {
                                    padding-bottom: 15px !important;
                                    height: fit-content;
                                }
                            </style>
                            <a asp-page="/ProductDetail" asp-route-slug="@item.Slug" class="mr-0 details-btn ripple-btn">جزئیات</a>
                            <button class="cart-btn ripple-btn d-none">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}