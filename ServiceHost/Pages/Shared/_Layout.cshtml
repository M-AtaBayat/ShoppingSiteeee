@using ShoppingSiteManagement.Application.Contracts.CartAPC
@inject ICartApplication CartApplication

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | پارسو شاپ" : "ParsoShop - پارسو شاپ")</title>

    <meta name="description" content="@(ViewData["MetaDescription"] ?? "فروشگاه پوشاک پارسو، مدرن ترین پوشاک وارداتی اروپایی، وارد کننده برند های esmara و Crivit و LIVERGY")" />
    <meta name="keywords" content="@(ViewData["Keywords"] ?? "پارسو شاپ, لباس وارداتی, خرید لباس اروپایی, esmara, Crivit")" />
    <meta name="author" content="ParsoShop">
    <meta name="robots" content="index, follow">

    @if (ViewData["CanonicalUrl"] != null)
    {
        <link rel="canonical" href="@ViewData["CanonicalUrl"]" />
    }

    <meta property="og:site_name" content="پارسو شاپ" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "مدرن ترین پوشاک وارداتی اروپایی")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "/assets/icons/favicon.png")" />
    <meta property="og:type" content="website" />
    <link rel="shortcut icon" href="~/assets/icons/favicon.png">

    <link rel="stylesheet" href="~/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/assets/css/MainStyle.css?v11.231.228">

</head>

<body>

    <nav class="mobile-dock shadow-lg">
        <a href="@(User.Identity.IsAuthenticated ? "/Profile" : "./Login")" id="profilepage" class="dock-item ripple-btn" data-target="profile">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
        </a>
        <a asp-page="./Offers" class="dock-item ripple-btn" data-target="offers" id="offerpage">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
        </a>
        <a href="@(User.Identity.IsAuthenticated ? "/Basket" : "./Login")" class="dock-item cart-3d ripple-btn" data-target="basket" id="basketpage">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            @{
                int count = 0;
                if (User.Identity.IsAuthenticated)
                {
                    var cart = CartApplication.GetCart(User.Identity.Name);
                    count = cart.TotalItems;
                }
            }
            @if (count > 0)
            {
                <span class="badge-count" id="badge-count">@count</span>
            }
        </a>
        <a asp-page="./Products" class="dock-item ripple-btn" data-target="search" id="productspage">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </a>
        <a asp-page="./Index" class="dock-item ripple-btn active" data-target="home" id="homepage">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
        </a>
    </nav>

    @RenderBody()

    <script src="~/assets/vendor/bootstrap/js/popper.min.js"></script>
    <script src="~/assets/vendor/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/assets/js/Sequrity.js"></script>
    <script src="~/assets/js/MainScript.js?v15.11.21"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>