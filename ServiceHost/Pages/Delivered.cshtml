@page
@model ServiceHost.Pages.DeliveredModel
@{
    ViewData["Title"] = "سفارش‌های تحویل‌یافته";
}

<main style="padding-bottom: 150px;">
    <div class="container text-right pt-0">
        <div class="text-right">
            <a asp-page="/Profile" class="text-dark card-btn mb-3">بازگشت</a>
        </div>

        <div class="page-title">سفارش‌های تحویل‌شده</div>
        <div class="page-sub">
            لیست تمام سفارش‌هایی که با موفقیت به دست شما رسیده‌اند.
        </div>

        @if (!Model.Orders.Any())
        {
            <div class="text-center mt-5 p-5 bg-white rounded shadow-sm">
                <i class="bi bi-check2-all text-success" style="font-size: 3rem;"></i>
                <h6 class="mt-3 text-muted">هنوز هیچ سفارشی در لیست تحویل‌یافته‌های شما ثبت نشده است.</h6>
            </div>
        }
        else
        {
            @foreach (var order in Model.Orders)
            {
                <div class="order-card">
                    <div class="order-grid">
                        <div class="info-box">
                            <div class="info-label">کد پیگیری</div>
                            <div class="info-value">@order.TrackingCode</div>
                        </div>
                        <div class="info-box">
                            <div class="info-label">تاریخ ثبت</div>
                            <div class="info-value">@order.CreationDate</div>
                        </div>
                        <div class="info-box">
                            <div class="info-label">تاریخ تحویل</div>
                            <div class="info-value">@order.DeliveryDate</div>
                        </div>
                        <div class="info-box">
                            <div class="info-label">گیرنده</div>
                            <div class="info-value">@order.ReceiverName</div>
                        </div>
                    </div>

                    <div class="products">
                        @order.ProductsSummary
                    </div>

                    <div class="total-price">
                        مبلغ نهایی: @order.FinalAmount.ToString("N0") تومان
                    </div>
                </div>
            }
        }
    </div>
</main>

<script>
    document.getElementById("homepage")?.classList.remove("active");
    document.getElementById("productspage")?.classList.remove("active");
    document.getElementById("basketpage")?.classList.remove("active");
    document.getElementById("offerpage")?.classList.remove("active");
    document.getElementById("profilepage")?.classList.add("active");
</script>
