@page
@model ServiceHost.Pages.OffersModel
@{
}
<main style="padding-bottom: 150px;">
    <div class="container pt-3">
        @if (!Model.OfferedProducts.Any())
        {
            <div class="text-center mt-5">
                <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" viewBox="0 0 24 24" fill="none" class="text-muted"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                    <line x1="5" y1="5" x2="5.01" y2="5"></line>
                </svg>
                @* <i class="bi bi-box-seam text-muted" style="font-size: 4rem;"></i> *@
                <h6 class="mt-3">درحال حاضر محصولی شامل تخفیف نیست.</h6>
                <a asp-page="/Products" class="btn btn-outline-dark mt-3">مشاهده دیگر محصولات</a>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model.OfferedProducts)
                {
                    <div class="col-6 col-md-4 col-lg-3 text-center  py-3">
                        <div class="product-card discount w-100">
                            <div class="product-img">
                                <img src="/@item.Picture" alt="@item.Slug">
                                <span class="discount-badge">@item.DiscountRate% تخفیف</span>
                            </div>
                            <h4 class="product-name">@item.Name</h4>
                            <div class="product-actions row justify-content-around mb-1">
                                <span class="color-box shadow-sm" style="background:@item.Color; border: 1px solid #ddd;width:15px; height:15px;"></span>
                                <span class="text-muted">@item.Size</span>
                            </div>
                            <div class="product-price">
                                <span class="old-price">@item.Price.ToString("N0") تومان</span>
                                <br>
                                <span class="new-price">@item.PriceWithDiscount تومان</span>
                            </div>
                            <div class="product-actions">
                                <style>
                                                            .product-card {
                                                                padding-bottom: 15px !important;
                                                                height: fit-content;
                                                            }
                                </style>
                                <a asp-page="/ProductDetail" asp-route-slug="@item.Slug" class="mr-0 details-btn ripple-btn">جزئیات</a>
                            </div>
                        </div>
                    </div>
                }

            </div>
        }
    </div>
</main>
<script>
    document.getElementById("homepage").classList.remove("active");
    document.getElementById("productspage").classList.remove("active");
    document.getElementById("basketpage").classList.remove("active");
    document.getElementById("offerpage").classList.add("active");
    document.getElementById("profilepage").classList.remove("active");
</script>