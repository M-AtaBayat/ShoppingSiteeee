<!-- ✅ آلرت Timeout خوشگل با دو گزینه -->
<script>
    let timeLeft = 600;
    let countdown;
    const timerElement = document.getElementById('timer');

    function startCountdown() {
        countdown = setInterval(() => {
            let minutes = Math.floor(timeLeft / 60);
            let seconds = timeLeft % 60;
            seconds = seconds < 10 ? '0' + seconds : seconds;
            timerElement.innerHTML = `${minutes}:${seconds}`;

            if (timeLeft <= 0) {
                clearInterval(countdown);
                showTimeoutModal();
            }
            timeLeft--;
        }, 1000);
    }
    startCountdown();

    function showTimeoutModal() {
        const modalHTML = `
        <div class="modal fade show" id="timeoutModal" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content text-right" style="border-radius:15px; border: 2px solid #f5bc00; overflow: hidden;">
                    <div class="modal-header border-0" style="background: linear-gradient(135deg, #f5bc006c, #f5bc00);">
                        <h5 class="modal-title text-white w-100" style="font-weight: bold; font-size: 1.3rem;">
                            <i class="pt-2 bi bi-clock-history"></i> زمان شما تمام شد.
                        </h5>
                    </div>
                    <div class="modal-body py-4" style="background-color: #fff9f5;">
                        <div class="alert alert-warning mt-3 mb-3" style="border-radius: 10px; border: none; background-color: #ffe8cc;">
                            <i class="bi bi-exclamation-circle"></i>
                            مهلت ۱۰ دقیقه‌ای شما به پایان رسید.
                        </div>
                        <p style="color: #666; font-size: 0.95rem;">
                            می‌خوای همینجا بمونی و سفارشت رو ادامه بدی، یا برگردی به سبد خرید؟
                        </p>
                    </div>
                    <div class="modal-footer border-0 pt-0 d-flex gap-2" style="background-color: #fff9f5;">
                        <button type="button" class="btn btn-warning text-dark flex-grow-1" id="stayBtn" style="border-radius: 8px; font-weight: bold;">
                            <i class="bi bi-arrow-clockwise"></i> همینجا می‌مونم
                        </button>
                        <button type="button" class="btn btn-outline-secondary flex-grow-1" onclick="window.location.href='/Basket'" style="border-radius: 8px; border-width: 2px;">
                            بازگشت به سبد خرید
                        </button>
                    </div>
                </div>
            </div>
        </div>
        `;
        document.body.insertAdjacentHTML('beforeend', modalHTML);

        document.getElementById('stayBtn').addEventListener('click', () => {
            document.getElementById('timeoutModal').remove();
            timeLeft = 600;
            startCountdown();
        });
    }
</script>


<script>
    document.getElementById("homepage")?.classList.remove("active");
    document.getElementById("productspage")?.classList.remove("active");
    document.getElementById("basketpage")?.classList.add("active");
    document.getElementById("offerpage")?.classList.remove("active");
    document.getElementById("profilepage")?.classList.remove("active");
</script>
